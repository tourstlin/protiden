# 统一 LF：板子上的 shell/python 脚本带 CRLF 会报 bad interpreter
* text=auto eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.desktop text eol=lf
*.service text eol=lf
*.jpg binary
*.png binary

# Keil MDK 工程（firmware/）：Windows 工具链 + GBK 时代的老代码，
# 统一 CRLF 让 Keil 打开时不提示换行符问题
*.c        text eol=crlf
*.h        text eol=crlf
*.s        text eol=crlf
*.uvprojx  text eol=crlf
*.uvoptx   text eol=crlf
*.bat      text eol=crlf
